+  minimumIntervalSeconds: 18,
+  maximumIntervalSeconds: 65,
+  healthExponent: 1.4,
+  jitterMinimum: 0.8,
+  jitterMaximum: 1.2,
+  maximumActiveGlobal: 4,
+  maximumActivePerRoot: 1,
+  emergencyGraceSeconds: 8,
+  emergencyRetrySeconds: 6,
